FROM node:22-alpine AS user-builder
WORKDIR /src
COPY clients/user-client/package.json clients/user-client/package-lock.json ./
RUN npm ci
COPY clients/user-client/ ./
RUN npm run build

FROM node:22-alpine AS admin-builder
WORKDIR /src
COPY clients/admin-client/package.json clients/admin-client/package-lock.json ./
RUN npm ci
COPY clients/admin-client/ ./
RUN npm run build:web

FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    WEB_PORT=8080 \
    WEB_ROOT=/app/public \
    ADMIN_ROOT=/app/admin
WORKDIR /app
COPY websocket-bridge/package.json websocket-bridge/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY websocket-bridge/server.js ./server.js
COPY --from=user-builder /src/dist ./public
COPY --from=admin-builder /src/dist ./admin

USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
CMD ["node", "server.js"]

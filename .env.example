# HyperTicket environment variables example file
# Overrides db.* in config.json when present. Real process env vars win over this file.
# Copy to .env and fill in real values (.env is gitignored).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=hyperticket

# Account verification email. Use an app-specific SMTP authorization code.
HYPERTICKET_SMTP_HOST=smtp.example.com
HYPERTICKET_SMTP_PORT=465
HYPERTICKET_SMTP_USERNAME=user@example.com
HYPERTICKET_SMTP_AUTH_CODE=replace-with-app-password
HYPERTICKET_SMTP_FROM=user@example.com
HYPERTICKET_SMTP_FROM_NAME=HyperTicket
HYPERTICKET_SMTP_USE_TLS=true

# Development only. Writes OTPs to a local 0600 JSONL inbox instead of a provider.
HYPERTICKET_VERIFICATION_DEV_INBOX_ENABLED=false
HYPERTICKET_VERIFICATION_DEV_INBOX_PATH=logs/verification-inbox.jsonl

# Development-only ALIPAY/WECHAT placeholders. Keep disabled in production.
HYPERTICKET_PAYMENT_SIMULATED_CHANNELS_ENABLED=false
HYPERTICKET_PAYMENT_SIMULATED_WEBHOOK_SECRET=replace-with-a-development-secret

# AI log detector (copy to .env and fill real values; never commit secrets)
LOG_AI_LLM_BASE_URL=https://your-llm-endpoint.example/v1
LOG_AI_LLM_API_KEY=your-api-key
LOG_AI_LLM_MODEL=your-model
LOG_AI_LLM_API_STYLE=openai-compatible
LOG_AI_LLM_TIMEOUT_SECONDS=60
LOG_AI_LLM_MAX_INPUT_CHARS=120000

LOG_AI_PROJECT_ROOT=/home/shanchuan/HyperTicket
LOG_AI_LOG_DIR=/home/shanchuan/HyperTicket/logs
LOG_AI_REPORT_DIR=/home/shanchuan/HyperTicket/reports/log-ai-detector
LOG_AI_STATE_FILE=/home/shanchuan/HyperTicket/.log-ai-detector-state.json
LOG_AI_LEVELS=ERROR,FATAL
LOG_AI_CONTEXT_BEFORE_LINES=80
LOG_AI_CONTEXT_AFTER_LINES=40
LOG_AI_DEBOUNCE_SECONDS=30
LOG_AI_MAX_LOG_BYTES=1048576
LOG_AI_POLL_INTERVAL_SECONDS=1.5

# codegraph command templates. Adjust these to match the installed colbymchenry/codegraph CLI.
LOG_AI_CODEGRAPH_BIN=codegraph
LOG_AI_CODEGRAPH_INDEX_DIR=/home/shanchuan/HyperTicket/.codegraph
LOG_AI_CODEGRAPH_PROJECT=/home/shanchuan/HyperTicket
LOG_AI_CODEGRAPH_INDEX_CMD={bin} index {project_root} --output {index_dir}
LOG_AI_CODEGRAPH_SEARCH_CMD={bin} search --index {index_dir} {query}
LOG_AI_CODEGRAPH_UPDATE_CMD={bin} index {project_root} --output {index_dir}
LOG_AI_CODE_SEARCH_MAX_HITS=8

# Notifications: comma-separated channels: webhook,email
LOG_AI_NOTIFY_CHANNELS=
LOG_AI_WEBHOOK_URL=
LOG_AI_WEBHOOK_TIMEOUT_SECONDS=10
LOG_AI_SMTP_HOST=
LOG_AI_SMTP_PORT=587
LOG_AI_SMTP_USERNAME=
LOG_AI_SMTP_PASSWORD=
LOG_AI_SMTP_FROM=
LOG_AI_SMTP_TO=
LOG_AI_SMTP_USE_TLS=true

# HTTP API security (optional). When set, all /log-ai-detector/api/* requests
# require header: Authorization: Bearer <token>
LOG_AI_API_TOKEN=

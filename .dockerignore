# 构建时忽略的文件和目录

# 构建产物
build/
bin/
node_modules/
**/node_modules/
clients/*/dist/
clients/*/src-tauri/target/
clients/*/src-tauri/gen/
*.o
*.a
*.so

# 配置文件（包含敏感信息）
config.json
.env

# 日志文件
logs/
*.log

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# 文档
*.md
!README.md
docs/

# Docker and deployment files are not needed inside build contexts.
docker-compose.yml
deploy/

# 其他
.DS_Store
*.bak
*.tmp

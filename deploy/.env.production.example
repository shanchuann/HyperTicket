GHCR_OWNER=shanchuann
IMAGE_TAG=latest
WEB_PORT=8080
WS_ALLOWED_ORIGINS=https://tickets.example.com,http://tauri.localhost,tauri://localhost
HYPERTICKET_GATEWAY_TOKEN=replace-with-a-long-random-shared-token
TRUSTED_PROXY_ADDRESSES=

# Existing MySQL instance. This workflow never creates, migrates, or seeds it.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=hyperticket
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=hyperticket
DB_POOL_SIZE=8

# Optional SMTP and simulated payment settings.
HYPERTICKET_SMTP_HOST=
HYPERTICKET_SMTP_PORT=465
HYPERTICKET_SMTP_USERNAME=
HYPERTICKET_SMTP_AUTH_CODE=
HYPERTICKET_SMTP_FROM=
HYPERTICKET_SMTP_FROM_NAME=HyperTicket
HYPERTICKET_SMTP_USE_TLS=true
HYPERTICKET_VERIFICATION_MOCK_SMS_ENABLED=true
HYPERTICKET_VERIFICATION_EXPOSE_MOCK_CODE=true
HYPERTICKET_VERIFICATION_REQUIRED=true
HYPERTICKET_PAYMENT_SIMULATED_CHANNELS_ENABLED=false
HYPERTICKET_PAYMENT_SIMULATED_WEBHOOK_SECRET=
